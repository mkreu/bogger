post_install() {
  cat <<'EOF'
==> bogger setup
    1. Install the backend config:
       install -Dm600 /usr/share/doc/bogger/config.toml.example /etc/bogger/config.toml
    2. Edit /etc/bogger/config.toml
    3. Create runtime directories now if needed:
       systemd-tmpfiles --create /usr/lib/tmpfiles.d/bogger.conf
    4. Enable or start the service:
       systemctl enable --now bogger-backup.service
EOF
}

post_upgrade() {
  post_install
}
